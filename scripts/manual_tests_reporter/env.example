# Manual Tests Reporter — Environment Variables
#
# Export these variables before running (no .env auto-loading):
#   export DATADOG_API_KEY="<your-key>"
#
# The upload runs `datadog-ci junit upload`, which reads its own
# configuration from the environment:
#
#   DATADOG_API_KEY  (or DD_API_KEY)   — required for upload
#   DATADOG_SITE     (or DD_SITE)      — non-US1 sites, e.g. datadoghq.eu
#
# `datadog-ci` must be installed and on PATH:
#   npm install -g @datadog/datadog-ci
#
# Example usage:
#   export DATADOG_API_KEY="<your-key>"
#   uv run python -m scripts.manual_tests_reporter.manual_tests_reporter \
#       --tests-dir tests/network --from-cluster

DATADOG_API_KEY=""
# DATADOG_SITE="datadoghq.eu"

# Overrides cluster-architecture detection with a fixed value (e.g. amd64).
# Scan/batch/dry-run runs need neither a kubeconfig nor this variable.
# WARNING: must not be combined with --from-cluster (would report a wrong ARCH).
# export OPENSHIFT_VIRTUALIZATION_TEST_IMAGES_ARCH="amd64"
