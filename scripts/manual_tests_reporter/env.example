# Manual Tests Reporter — Environment Variables
#
# This tool writes a JUnit XML report; it does NOT push to Datadog, so it
# reads no Datadog credentials.
#
# Variables this tool honours:
#
#   KUBECONFIG
#     Only needed for --from-cluster (read out-of-band by the client, not by
#     this tool's own code). Scan, batch and dry-run runs work without it.
#
#   OPENSHIFT_VIRTUALIZATION_TEST_IMAGES_ARCH
#     Overrides the utilities package's cluster-architecture detection, which
#     runs at import time. Set it on hosts without a reachable cluster if the
#     import chain otherwise hangs or fails. The reporter emits no arch tag
#     either way.
#
# Example usage (no Datadog credentials needed):
#   uv run python -m scripts.manual_tests_reporter.manual_tests_reporter \
#       --tests-dir tests/network --from-cluster
#
# The report is written to ./xunit_results.xml unless --junit-output is given.
#
# ── Uploading the report later ──────────────────────────────────────────
# Uploading is a separate step, run in an environment that holds credentials:
#
#   npm install -g @datadog/datadog-ci
#   export DATADOG_API_KEY="<key>"        # or DD_API_KEY, read by datadog-ci
#   export DATADOG_SITE="datadoghq.eu"    # or DD_SITE; Jenkins uses datadoghq.eu
#   export DD_ENV="production"            # Jenkins' env facet (DatadogConfig.ENV)
#   datadog-ci junit upload --service cnv-qe-tests xunit_results.xml
#
# Use --service cnv-qe-tests and DD_ENV=production to land in the same
# service/env facets as the Jenkins datadog-upload-results pipeline; a
# US1-default host without DATADOG_SITE uploads to a different site entirely.
#
# The report already carries the run tags as dd_tags[...] properties, so the
# upload needs no --tags flags.

# export OPENSHIFT_VIRTUALIZATION_TEST_IMAGES_ARCH="amd64"
